# Backend Red Clínica — copie a server/.env
PORT=4000
JWT_SECRET=cambie-este-secreto
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
# Contraseña inicial de usuarios creados desde Administración (la UI no captura contraseña)
INITIAL_USER_PASSWORD=demo123

# Base central de usuarios (PostgreSQL)
CENTRAL_DATABASE_URL=postgres://rc_app:rc_app_pass@localhost:5432/red_central
# i1 Hospital General → PostgreSQL
POSTGRES_URL=postgres://rc_app:rc_app_pass@localhost:5432/hospital_general
# i2 Clínica Odontológica → MySQL
MYSQL_URL=mysql://rc_app:rc_app_pass@localhost:3306/clinica_odontologica
# i3 Laboratorio Clínico → MongoDB (replica set, necesario para transacciones)
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=laboratorio_clinico
# i4 Centro Médico Pediátrico → Firestore (emulador)
FIREBASE_PROJECT_ID=demo-red-clinica
FIRESTORE_EMULATOR_HOST=localhost:8080
# Evita la búsqueda de credenciales GCP (no aplica al emulador)
METADATA_SERVER_DETECTION=none
