{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@contracts": ["../src/types/index.ts"]
    }
  },
  "include": ["src", "test", "db/firestore/seed.ts", "vitest.config.ts"]
}
